		{
			"name": "Game Sessions",
			"description": "Endpoints to manage the game session lifecycle (creation, starting, current active question, turn progression, and restart).",
			"item": [
				{
					"name": "1. Create Game Session",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"if (jsonData && jsonData.data) {",
									"    pm.collectionVariables.set(\"game_id\", jsonData.data.id);",
									"    pm.collectionVariables.set(\"session_code\", jsonData.data.session_code);",
									"    if (jsonData.data.teams && jsonData.data.teams.length >= 2) {",
									"        pm.collectionVariables.set(\"team_id_1\", jsonData.data.teams[0].id);",
									"        pm.collectionVariables.set(\"team_id_2\", jsonData.data.teams[1].id);",
									"    }",
									"    console.log(\"Saved game_id:\", jsonData.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"team1_name\": \"Red Dragons\",\n    \"team2_name\": \"Blue Falcons\",\n    \"timer_duration_seconds\": 30\n}"
						},
						"url": {
							"raw": "{{base_url}}/games",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"games"
							]
						},
						"description": "Initializes a new game session with two teams and a default question timer duration. Automatically extracts and sets `game_id`, `team_id_1`, and `team_id_2` collection variables."
					},
					"response": []
				},
